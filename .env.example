# Generate a Personal Access Token with only domains.domain:read.
GODADDY_PAT=replace-with-your-read-only-token

# Optional. Required only for explicit DNS create apply operations.
# Recommended scopes: domains.domain:read and domains.dns:update.
GODADDY_WRITE_PAT=replace-with-your-separate-dns-write-token

# Live tests are disabled unless explicitly set to 1.
GODADDY_ENABLE_LIVE_TESTS=0
GODADDY_LIVE_TEST_DOMAIN=example.com
